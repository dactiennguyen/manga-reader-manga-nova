# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# iOS 16 is the floor: SSZipArchive needs it, and the orientation lock uses the iOS 16 geometry API.
platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Manganova' do
  config = use_native_modules!

  # Zip and unzip for project files and exports. iOS has no zip API of its own.
  pod 'SSZipArchive', '~> 2.6'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26.1's Swift compiler crashes ("Global is external, but doesn't have external or weak linkage")
    # when it optimizes VisionCamera as one whole module in Release. Compiling it file by file avoids that
    # and keeps the optimization. Remove once a newer Xcode builds it with whole-module optimization.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'VisionCamera'
      target.build_configurations.each do |build|
        build.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
      end
    end
  end
end
