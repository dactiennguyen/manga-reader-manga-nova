<?xml version="1.0" encoding="utf-8"?>
<!-- The streak part of the widget, shared by the small and the wide layout: the flame, the streak, a caption
     (or a nudge to draw), the goal bar and today's strokes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_column"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_flame"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_flame"
        android:tint="@color/widget_accent" />

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_preview_streak"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="@string/widget_name"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/widget_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar"
            android:tint="@color/widget_track" />

        <ImageView
            android:id="@+id/widget_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_fill"
            android:tint="@color/widget_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_progress"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
