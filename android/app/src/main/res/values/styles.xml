<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. The dark window colour avoids a white flash before the first frame. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/studio_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Three-button navigation otherwise gets a white scrim over the app. -->
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

</resources>
